# Production variables — copy to .env.production on the server and fill in; never commit the real file.
# Used by infrastructure/compose.prod.yml for interpolation (--env-file) and by the backend (env_file).

# --- Public site ---
# The real domain once bought (Q6); Caddy obtains the certificate automatically.
SITE_DOMAIN=jokardental.example
NEXT_PUBLIC_SITE_URL=https://jokardental.example
NEXT_PUBLIC_WHATSAPP_NUMBER=905427130132
HTTP_PORT=80
HTTPS_PORT=443

# --- Django ---
DJANGO_SECRET_KEY=change-me-long-random
# The public domain, plus "backend": the Next.js server reaches the API by its Docker service name.
DJANGO_ALLOWED_HOSTS=jokardental.example,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://jokardental.example
DJANGO_ADMIN_PATH=staff-change-me-random
DJANGO_ADMIN_2FA=true
ADMIN_BASE_URL=https://jokardental.example
INTERNAL_API_TOKEN=change-me-long-random

# --- Database ---
POSTGRES_DB=jokar
POSTGRES_USER=jokar
POSTGRES_PASSWORD=change-me-long-random

# --- Telegram lead notifications (Q5) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Backups (relative to infrastructure/) ---
BACKUP_DIR=./backups
