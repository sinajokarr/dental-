# JOKAR DENTAL — environment variables
# Local development:  cp .env.example .env   then replace every "change-me" value.
# Format: KEY=value, one per line, no inline comments. Never commit .env.
# A task that introduces a new variable adds it here in the same commit.

# --- Frontend (Next.js) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1
# Clinic WhatsApp, international digits only (no +, spaces or leading 0)
NEXT_PUBLIC_WHATSAPP_NUMBER=905427130132

# --- Backend (Django) ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Admin is served at /<DJANGO_ADMIN_PATH>/ — use a non-guessable value outside local development
# Shared secret between the Next.js Server Action and the internal Django API
INTERNAL_API_TOKEN=change-me
# Where the Next.js Server Action posts consultation requests (internal network only; Docker: http://backend:8000/...)
LEAD_API_URL=http://127.0.0.1:8000/api/v1/leads/
DJANGO_ADMIN_PATH=staff-change-me

# Two-factor sign-in for the admin (TOTP). Keep true everywhere except local development
DJANGO_ADMIN_2FA=true
# Public origin(s) of the admin, comma-separated, e.g. https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database (PostgreSQL; also read by infrastructure/compose.dev.yml) ---
# Dev DB uses host port 5433 so it never clashes with a locally installed PostgreSQL on 5432
POSTGRES_DB=jokar_dental
POSTGRES_USER=jokar
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Telegram lead notifications (optional until the bot exists) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Base URL used in the notification's "Open in admin" link
ADMIN_BASE_URL=http://localhost:8000
