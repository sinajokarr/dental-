# JOKAR DENTAL — environment variables
# Local development:  cp .env.example .env   then replace every "change-me" value.
# Format: KEY=value, one per line, no inline comments. Never commit .env.
# A task that introduces a new variable adds it here in the same commit.

# --- Frontend (Next.js) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1
# Clinic WhatsApp, international digits only (no +, spaces or leading 0)
NEXT_PUBLIC_WHATSAPP_NUMBER=905427130132

# --- Backend (Django) ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Admin is served at /<DJANGO_ADMIN_PATH>/ — use a non-guessable value outside local development
DJANGO_ADMIN_PATH=staff-change-me

# --- Database (PostgreSQL; also read by infrastructure/compose.dev.yml) ---
# Dev DB uses host port 5433 so it never clashes with a locally installed PostgreSQL on 5432
POSTGRES_DB=jokar_dental
POSTGRES_USER=jokar
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
